# Copy to .env.local for development. Never commit real values.

# --- Server-only (src/lib/env.ts) ---

# Resend (https://resend.com) API key used to send inquiry-form emails.
# TODO(client/ops): real production key, once the inquiry desk inbox is confirmed.
RESEND_API_KEY=

# Where inquiry-form submissions are emailed. TODO(client): confirm one
# canonical email address — guide.md §1.5 found conflicting addresses in use.
INQUIRY_TO_EMAIL=

# The "from" address Resend sends as (must be a domain verified with Resend).
INQUIRY_FROM_EMAIL=

# Shared secret for the future CMS revalidation webhook (code.md §19). Not
# used until Payload is wired in; optional for Phase 1.
REVALIDATE_SECRET=

# --- Public (exposed to the browser) ---

# Canonical site URL, used for metadataBase, sitemap, JSON-LD, OG images.
# TODO(client): junaidigroup.com is currently a broken "Index of /" listing
# (guide.md §1.5) — point this at the real production domain once it's live.
NEXT_PUBLIC_SITE_URL=https://junaidigroup.com

# WhatsApp number used by every wa.me deep link on the site, digits only,
# country code first (e.g. 923001234567). TODO(client): guide.md §1.1 found
# two different numbers in use (+92 332 2202656 on Facebook, +92 323 4271012
# elsewhere) — confirm the one primary Hajj/Umrah desk number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# GA4 measurement ID. Out of scope for Phase 1 (prompt.md: "analytics
# consent banner (stub the track() helper only)") — leave unset.
NEXT_PUBLIC_GA_ID=
